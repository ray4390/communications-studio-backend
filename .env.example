NODE_ENV=production
PORT=8787
# Optional second listener for an existing reverse-proxy or Funnel route.
COMPATIBILITY_PORT=

# Public HTTPS origin for this API, no trailing slash.
PUBLIC_BASE_URL=https://communications-api.example.com

# GitHub Pages frontend currently lives here.
FRONTEND_ORIGIN=https://nationalarchivesusar.github.io
FRONTEND_PATH=/communications-studio/

DATABASE_PATH=./data/communications-studio.sqlite
SESSION_TTL_DAYS=30
OAUTH_TTL_MINUTES=10
AUTHZ_CACHE_SECONDS=300
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
REQUIRE_DISCORD=true

# Sentry observability. Leave SENTRY_DSN blank to disable reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional override. Defaults to the server hostname.
SENTRY_HOST=

# Discord application / bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=886068973886640129
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://communications-api.example.com/auth/discord/callback

# Roblox OAuth application
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://communications-api.example.com/auth/roblox/callback

# Approved publication channels
CHANNEL_WHITE_HOUSE=899467464826556427
CHANNEL_EXECUTIVE=886076674792390707
CHANNEL_LEGISLATIVE=886077286414172171
CHANNEL_JUDICIAL=886077834911678464
CHANNEL_FEC=1076283102822940713

# Approved notification roles
PING_ROLE_EXECUTIVE=937155572342587392
PING_ROLE_WHITE_HOUSE=1156347407899041812
PING_ROLE_LEGISLATIVE=1156346015234924615
PING_ROLE_JUDICIAL=1156346227286360236
